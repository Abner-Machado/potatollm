{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lowrambench result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "model",
    "quantization",
    "size_gb",
    "backend",
    "backend_version",
    "cpu",
    "ram_total_gb",
    "os",
    "prompt_id",
    "generated_tokens",
    "duration_s",
    "tok_s",
    "min_free_ram_gb",
    "peak_pagefile_gb",
    "paged",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "2.0" },
    "date": { "type": "string" },
    "model": { "type": "string" },
    "quantization": { "type": "string" },
    "size_gb": { "oneOf": [{ "type": "number" }, { "const": "unknown" }] },
    "backend": { "type": "string" },
    "backend_version": { "type": "string" },
    "cpu": { "type": "string" },
    "ram_total_gb": { "oneOf": [{ "type": "number" }, { "const": "unknown" }] },
    "os": { "type": "string" },
    "prompt_id": { "type": "string" },
    "generated_tokens": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "const": "unknown" }] },
    "duration_s": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] },
    "tok_s": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] },
    "min_free_ram_gb": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] },
    "peak_pagefile_gb": { "oneOf": [{ "type": "number", "minimum": 0 }, { "const": "unknown" }] },
    "paged": { "oneOf": [{ "type": "boolean" }, { "const": "unknown" }] },
    "status": { "type": "string" }
  }
}